rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /inventory/{allPaths=**} {
      allow read: if true;
      // Photo uploads follow the same admin-or-staff gate as inventoryItems
      // writes in firestore.rules, via a cross-service lookup into the
      // users/{authUid} mirror doc. Requires that doc to already exist —
      // same bootstrap dependency as the Firestore rules, so this only
      // works once the Firestore rules deploy (and the backfill runs) too.
      allow write: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'staff'];
    }
  }
}
